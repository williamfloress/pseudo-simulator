# Python / Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Entornos Virtuales
venv/
env/
ENV/
.venv/
.env

# Editores y Entornos de Desarrollo / SO
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Logs y archivos de bases de datos o temporales
*.log
*.sqlite
*.sqlite3
*.db

# Archivos minificados generados en el proyecto
*.min.js
*.min.css
*.min.*

# Excepción: No ignorar archivos vendor (necesarios para soporte offline del frontend)
!frontend/vendor/
!frontend/vendor/**

# Carpetas de documentación (Solicitado por el usuario)
/documentacion/
